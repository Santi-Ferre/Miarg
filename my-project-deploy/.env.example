# Copy these names into your environment provider; replace every placeholder.
# Keep ADMIN_PASSWORD and ADMIN_SESSION_SECRET private. Never prefix them with NEXT_PUBLIC_.
ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-16-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-private-token
